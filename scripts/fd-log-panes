#!/usr/bin/env bash
set -euo pipefail
if (( $# < 4 )) || [[ $3 != -- ]] || [[ $1 != tmux && $1 != rex ]]; then
    printf 'Usage: fd-log-panes {tmux|rex} DIRECTORY -- COMMAND [ARG ...]\n' >&2
    exit 2
fi
backend=$1
directory=$2
shift 3
if ! command -v "$backend" >/dev/null 2>&1; then
    printf '%s is not installed or not on PATH.\n' "$backend" >&2
    exit 2
fi
if [[ $backend == tmux && ( -z ${TMUX:-} || -z ${TMUX_PANE:-} ) ]]; then
    printf 'Run the tmux helper inside a tmux session.\n' >&2
    exit 2
fi
if [[ $backend == rex && -z ${REX_BLOCK:-} ]]; then
    printf 'Run the Rex helper inside a Rex pane (REX_BLOCK must be set).\n' >&2
    exit 2
fi
mkdir -p -- "$directory"
directory=$(cd -- "$directory" && pwd -P)
if [[ $backend == tmux ]]; then
    caller=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_id}')
    if [[ $caller != "$TMUX_PANE" ]]; then
        printf 'The calling tmux pane no longer exists.\n' >&2
        exit 2
    fi
    server=$(tmux display-message -p -t "$caller" '#{pid}')
    state="$directory/.fd-log-tmux-$server-${caller#%}"
else
    caller=$REX_BLOCK
    rex 'do' -b "$caller" -e 'assert(rex.session.view {})' >/dev/null
    state="$directory/.fd-log-rex-${caller#block:}"
fi
export FD_LOG_BACKEND=$backend FD_LOG_CALLER=$caller FD_LOG_STATE=$state
# Discover streams as records arrive. Regular files let viewers outlive commands.
script_directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
collector=fd-log-run
[[ -x $script_directory/fd-log-run ]] && collector=$script_directory/fd-log-run
exec "$collector" --on-stream "$script_directory/fd-log-view" "$directory" -- "$@"
